<?xml version="1.0" ?>
<!--
  VNS Test World - QAU Campus, Islamabad, Pakistan
  A Gazebo world representing Quaid-i-Azam University campus
  for testing GNSS-denied visual navigation.
  
  Location: QAU Campus, Islamabad, Pakistan
  Approximate Center: 33.7470°N, 73.1370°E
  
  Features:
  - QAU campus buildings as visual landmarks
  - Flat terrain representing campus grounds
  - Configurable GPS plugin for enable/disable testing
  - Camera-friendly lighting conditions
-->
<sdf version="1.9">
  <world name="qau_campus_world">
    
    <!-- Spherical coordinates for QAU Campus, Islamabad -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>33.7470</latitude_deg>
      <longitude_deg>73.1370</longitude_deg>
      <elevation>550</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    
    <!-- Physics settings optimized for drone simulation -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    
    <!-- Scene lighting for good visual feature detection -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- Sun light source (positioned for Islamabad latitude) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    
    <!-- Ground plane representing QAU campus grounds -->
    <model name="qau_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <!-- Base plane visual for terrain beyond the textured campus map -->
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.3 1</ambient>
            <diffuse>0.4 0.5 0.35 1</diffuse>
          </material>
        </visual>
        <!-- QAU campus satellite/reference-map texture (600x600 m, georeferenced
             mosaic of the VNS reference-database tiles; world origin == DB center).
             Mapped 1:1 onto a thin box so the downward camera sees terrain that
             matches the reference tiles. -->
        <visual name="campus_map">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>600 600 0.04</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file:///home/hp/GPS-DENIED-SYSTEM/simulation/worlds/materials/scripts</uri>
              <uri>file:///home/hp/GPS-DENIED-SYSTEM/simulation/worlds/materials/textures</uri>
              <name>QAUCampus/Ground</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- QAU CAMPUS LANDMARKS - Distinctive buildings -->
    <!-- ============================================ -->
    
    <!-- QAU Main Administration Building (Central) -->
    <model name="qau_admin_building">
      <static>true</static>
      <pose>0 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>40 25 15</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>40 25 15</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.82 0.75 1</ambient>
            <diffuse>0.9 0.87 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- QAU Library Building (East of Admin) -->
    <model name="qau_library">
      <static>true</static>
      <pose>80 20 6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 20 12</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 20 12</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.65 0.55 1</ambient>
            <diffuse>0.75 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Physics Department Building (Northwest) -->
    <model name="qau_physics_dept">
      <static>true</static>
      <pose>-60 70 5 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>35 18 10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>35 18 10</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.8 1</ambient>
            <diffuse>0.8 0.8 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Chemistry Department Building (Northeast) -->
    <model name="qau_chemistry_dept">
      <static>true</static>
      <pose>70 80 5.5 0 0 -0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>28 22 11</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>28 22 11</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.78 0.7 1</ambient>
            <diffuse>0.85 0.83 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Biology Department Building (Southeast) -->
    <model name="qau_biology_dept">
      <static>true</static>
      <pose>90 -60 4.5 0 0 0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>32 16 9</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>32 16 9</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.78 0.72 1</ambient>
            <diffuse>0.77 0.83 0.77 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Computer Science Department (Southwest) -->
    <model name="qau_cs_dept">
      <static>true</static>
      <pose>-80 -50 5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>25 20 10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>25 20 10</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.65 0.75 1</ambient>
            <diffuse>0.65 0.7 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- QAU Mosque (Distinctive landmark with dome) -->
    <model name="qau_mosque">
      <static>true</static>
      <pose>-30 100 0 0 0 0</pose>
      <link name="base">
        <collision name="collision">
          <geometry>
            <box><size>20 20 8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 4 0 0 0</pose>
          <geometry>
            <box><size>20 20 8</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dome">
        <pose>0 0 8 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere><radius>6</radius></sphere>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.3 1</ambient>
            <diffuse>0.25 0.55 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="minaret">
        <pose>12 0 10 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>1.5</radius>
              <length>20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- QAU Water Tower (Tall distinctive landmark) -->
    <model name="qau_water_tower">
      <static>true</static>
      <pose>120 0 15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>4</radius>
              <length>30</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>4</radius>
              <length>30</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.55 0.6 1</ambient>
            <diffuse>0.55 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Student Hostels Area (West side) -->
    <model name="qau_hostel_block_1">
      <static>true</static>
      <pose>-120 30 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>40 12 8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>40 12 8</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.55 1</ambient>
            <diffuse>0.75 0.65 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="qau_hostel_block_2">
      <static>true</static>
      <pose>-120 -30 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>40 12 8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>40 12 8</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.55 1</ambient>
            <diffuse>0.75 0.65 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Sports Complex (South) -->
    <model name="qau_sports_complex">
      <static>true</static>
      <pose>0 -120 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>50 30 6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 30 6</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- GROUND MARKERS - Visual reference patterns -->
    <!-- ============================================ -->
    
    <!-- Helipad marker near Admin building -->
    <model name="helipad_marker">
      <static>true</static>
      <pose>30 -30 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>5</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.2 1</ambient>
            <diffuse>0.95 0.95 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Road markings / pathways -->
    <model name="main_road_ns">
      <static>true</static>
      <pose>40 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>8 200 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="main_road_ew">
      <static>true</static>
      <pose>0 40 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>200 8 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Parking areas with distinctive patterns -->
    <model name="parking_area_1">
      <static>true</static>
      <pose>-40 -20 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>25 15 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.45 0.45 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Trees as visual landmarks (simplified as cylinders) -->
    <model name="tree_cluster_1">
      <static>true</static>
      <pose>20 60 3 0 0 0</pose>
      <link name="trunk">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="canopy">
        <pose>0 0 5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere><radius>4</radius></sphere>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.25 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="tree_cluster_2">
      <static>true</static>
      <pose>-50 20 3 0 0 0</pose>
      <link name="trunk">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="canopy">
        <pose>0 0 5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere><radius>3.5</radius></sphere>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.25 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>