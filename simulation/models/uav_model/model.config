<?xml version="1.0" ?>
<model>
  <name>VNS Drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  
  <author>
    <name>VNS Team</name>
    <email>vns@example.com</email>
  </author>
  
  <description>
    Quadcopter drone model with downward-facing camera for visual navigation
    testing in GNSS-denied environments. Designed for use with PX4 SITL
    and the Visual Navigation System (VNS).
    
    Features:
    - Downward-facing RGB camera (640x480 @ 30Hz)
    - Configurable GPS sensor (can be disabled for testing)
    - IMU sensor for attitude estimation
    - Compatible with PX4 SITL via MAVLink
    
    Location: QAU Campus, Islamabad, Pakistan
  </description>
</model>