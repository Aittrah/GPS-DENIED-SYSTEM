<?xml version="1.0" ?>
<model>
  <name>Iris with Downward Camera</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>VNS Team</name>
  </author>

  <description>
    PX4 iris quadcopter with a downward-facing RGB camera for visual
    navigation in GNSS-denied environments.  Includes gazebo_ros plugins
    that publish camera, IMU, GPS, and ground-truth on ROS 2 topics
    under the /vns_drone namespace.
  </description>
</model>
