<?xml version="1.0" ?>
<model>
  <name>QAU Ground Plane (Satellite Textured)</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <author>
    <name>VNS Team</name>
  </author>

  <description>
    Static ground plane for the QAU campus world, textured with a cleaned
    real satellite photo of Quaid-i-Azam University (data/satellite/raw/qau_campus_satellite.jpg,
    processed by simulation/scripts/build_satellite_ground_texture.py). Replaces
    the untextured/plain-color ground that previously caused the downward
    camera to capture green/featureless frames. Portable model://qau_ground_plane
    include -- no hardcoded host paths.
  </description>
</model>
